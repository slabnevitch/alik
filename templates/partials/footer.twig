<footer class="footer">
	<div class="footer__wrapper">
		<div class="footer__body">
			<div class="footer__content">
				<a href="#" class="footer__logo">
					<img src="/src/assets/img/logo.svg" alt="alt">
				</a>
				{% set socials = [{title:'Twitter', icon:'soc-tw'}, {title:'Dribbble', icon:'soc-ball'}, {title:'Instagram', icon:'soc-inst'}, {title:'Behance', icon:'soc-be'}] %}
				<ul class="footer__socials socials socials--vert">
					{% for soc in socials %}
						<li class="socials__item">
							<a href="#" class="social__link social__link--text icon-font {{ soc.icon }}">{{soc.title}}</a>
						</li>
					{% endfor %}
				</ul>
			</div>
			<div class="footer__menus">
				<div class="footer__menu menu-footer" data-spoilers data-minimizeSiblings data-point="767.98">
					<details data-spoiler-item>
						<summary class="menu-footer__title" data-spoiler-title>Pages</summary>

						{% set menu1 = ['Home','Services','About','Contact'] %}
						<div data-spoiler-content>
							<ul class="menu-footer__list">
								{% for item in menu1 %}
									<li class="menu-footer__item">
										<a href="#" class="menu-footer__link">{{item}}</a>
									</li>
								{% endfor %}
								<li class="menu-footer__item">
									<button class="btn btn--arrow btn--inv">More Templates<i class="icon-font arrrow-r-t"></i></button>
									
								</li>
							</ul>
						</div>
					</details>
				</div>
				<div class="footer__menu menu-footer" data-spoilers data-minimizeSiblings data-point="767.98">
					<details data-spoiler-item>
						<summary class="menu-footer__title" data-spoiler-title>CMS</summary>
						<div data-spoiler-content>
							<ul class="menu-footer__list">
								{% for item in ['Work','Work Single','Blog','Blog Post'] %}
									<li class="menu-footer__item">
										<a href="#" class="menu-footer__link">{{item}}</a>
									</li>
								{% endfor %}
							</ul>
						</div>
					</details>
				</div>
				<div class="footer__menu menu-footer" data-spoilers data-minimizeSiblings data-point="767.98">
					<details data-spoiler-item>
						<summary class="menu-footer__title" data-spoiler-title>Utility Pages</summary>
						<div data-spoiler-content>
							<ul class="menu-footer__list">
								{% for item in ['404 Error Page','Password Protected','Styleguide','Licensing','Changelog'] %}
									<li class="menu-footer__item">
										<a href="#" class="menu-footer__link">{{item}}</a>
									</li>
								{% endfor %}
							</ul>
						</div>
					</details>
				</div>
			</div>
		</div>	
	</div>
	
</footer>