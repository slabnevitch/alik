<section class="services">
	<div class="services__wrapper">
		{% for key, value in site.services %}
			<article class="service blur-border">
				<div class="service__label">{{value.label}}</div>
				<h2 class="service__title">
					<a href="@" class="service__title-link">{{value.title}}</a>
				</h2>
				<a class="service__link-image">
					<img src="/src/assets/img/selected/{{key+1}}.jpg" alt="" class="service__image">
				</a>
				<table class="service__table table-service">
					{% for i, val in value.table %}
						<tr class="table-service__row">
							<td class="table-service__label">{{val.name}}</td>
							<td class="table-service__text">
								{% if i==0 %}
									<div class="read-more" data-more>
										<div class="read-more__content" data-more-content data-more-height="115.2" >
											{% for i in 0..3 %}
												<p>{{val.val}}</p>
											{% endfor %}
										</div>
										<div class="read-more__footer" data-more-footer>
											<a href="#" class="read-more__btn table-service__more" data-more-trigger data-more-text-more="Show me more"
											data-more-text-less="Show me less">
											Show me more
										</a>
									</div>
								</div>
								
								{% else %}
									<div class="read-more" data-more>
										<div class="read-more__content" data-more-content data-more-height="115.2" >
											<p>{{val.val}}</p>
										</div>
										<div class="read-more__footer" data-more-footer>
											<a href="#" class="read-more__btn table-service__more" data-more-trigger data-more-text-more="Show me more"
											data-more-text-less="Show me less">
											Show me more
										</a>
									</div>
								</div>
								{% endif %}
							</td>
						</tr>
					{% endfor %}
				</table>
			</article>
		{% endfor %}
	</div>
</section>