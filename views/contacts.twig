{% extends "templates/layouts/base.twig" %}

{% set title = "Contacts" %}

{% set pageName = "contacts" %}

{% block content %}
	<div class="contacts">
		<div class="contacts__wrapper">
			<figure class="contacts__picture">
				<img src="/src/assets/img/hero/hero-img.png" alt="image№" class="ontacts__img">
			</figure>

			<div class="contacts__body">
				<div class="contacts__form form-contacts blur-border">
					<div class="form-contacts__header">
						<div class="form-contacts__label label">Contact</div>
						<h1 class="form-contacts__title title">Let’s get in touch.</h1>
					</div>

					<form action="#" method='POST' class="form-contacts__body form formhandler">
						<div class="formhandler__notices"></div>
						<label class="form__label">
							<input  type="text" name="name" class="form__input formhandler__field" placeholder="name"/>
							<span class="field-notice"></span>
						</label>
						<label class="form__label">
							<span class="field-notice"></span>
							<input  type="email" name="email" class="form__input formhandler__field" placeholder="email"/>
						</label>
						<label class="form__label">
							<span class="field-notice"></span>
							<textarea data-autosize class="form__input form__area formhandler__field" autocomplete="off" name="message" id="" placeholder="message"></textarea>
						</label>
						<button type="submit" name="submit" class="btn btn--inv form__send formhandler__submit">Send Message</button>
					</form>
				</div>
				<ul class="arik__socials soc-block">
					{% for item in site.arikSocials %}
						<li class="soc-block__item">
							<a href="#" target="_blank" class="blur-border soc-block__link icon-font {{ item.icon }}">{{item.title}}<i class="soc-block__arrow icon-font arrrow-r-t"></i></a>
						</li>
					{% endfor %}
				</ul>
			</div>


		</div>
	</div>
	<div class="graph-modal">
		<div class="graph-modal__container  modal send-modal" role="dialog" aria-modal="true" data-graph-target="formsend">
			<button class="btn-reset graph-modal__close modal-close js-modal-close" aria-label="Закрыть модальное окно"></button>
			<div class="graph-modal__content">
				<h1>Сообщение отправлено!</h1>
			</div>
		</div>
	</div>
{% endblock %}
